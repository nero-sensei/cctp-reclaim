{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jigs-rpc",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rpc.jigs.fyi", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://jigs.fyi",
  },
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
}
